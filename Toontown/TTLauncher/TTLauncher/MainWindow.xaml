        <Button x:Name="button" Content="Exit" HorizontalAlignment="Left" Margin="593,150,0,0" VerticalAlignment="Top" Width="101" Height="45" Click="button_Click" Grid.Row="3"/>
        <Button x:Name="button1" Content="Launch" HorizontalAlignment="Left" Margin="16,150,0,0" VerticalAlignment="Top" Width="101" Height="45" Click="button1_Click" Grid.Row="3"/>
        <Image x:Name="_080a0571d52b2c542938967770efebe4_png" Margin="62,10,82,0" Source="TTImage.png" Stretch="Fill"/>
        <WebBrowser x:Name="Browser" HorizontalAlignment="Left" Height="289" Margin="10,10,0,0" VerticalAlignment="Top" Width="698" Grid.RowSpan="3" Uid="www.google.com" Grid.Row="1"/>
        <Button x:Name="button2" Content="News Page" HorizontalAlignment="Left" Margin="285,150,0,0" Grid.Row="3" VerticalAlignment="Top" Width="101" Height="45" Click="button2_Click"/>


    </Grid>
</Window>
